# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.test_tmp/
.git-backup-*/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Build
build/
dist/
*.egg-info/

# Large local data and model artifacts
data/raw_data/*
data/processed_data/*
models/**/*.pkl
models/**/*.joblib
models/**/*.pt
models/**/*.ckpt
models/**/*.onnx
models/**/.cache/
results/**/*.html
results/**/*.png
results/**/*.pdf
results/smoke_tests/
archives/

# Large local source PDFs and full-text extraction scratch (kept local only)
pdf/
.fulltext_extract/

# Leftover git-recovery directories
.git.corrupt_*/
.git-recovered-*/

# Render artifacts under outputs/ (keep xlsx/ndjson, drop previews)
outputs/*.png

# Keep directory placeholders
!data/**/.gitkeep
!models/**/.gitkeep
!results/**/.gitkeep
